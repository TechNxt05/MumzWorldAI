# ── LLM Provider Configuration ────────────────────────────────────────────────
# Choose your LLM provider: "gemini" (default) or "openrouter"
LLM_PROVIDER=gemini

# ── Gemini API (Direct) ──────────────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenRouter API (Alternative — 300+ models via one key) ──────────────────
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use for Compare AI (needs strong reasoning)
# Recommended free models:
#   google/gemma-3-27b-it:free          — Google's best free model
#   nvidia/llama-3.3-nemotron-super-120b-instruct:free  — Excellent reasoning
#   qwen/qwen3-next-80b-a3b-instruct:free  — Strong structured output
#   openrouter/auto                     — Auto-routes to best available model
OPENROUTER_COMPARE_MODEL=nvidia/llama-3.3-nemotron-super-120b-instruct:free

# Model to use for Shopping Assistant (needs speed)
# Recommended free models:
#   google/gemma-3-27b-it:free
#   nvidia/llama-3.3-nemotron-nano-30b-v1:free
#   openrouter/auto
OPENROUTER_ASSISTANT_MODEL=google/gemma-3-27b-it:free
